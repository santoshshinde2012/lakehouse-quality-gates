# soda-lakehouse-dq settings (prefix DQ_, read by pydantic-settings). Copy: make env
# Engine: duckdb (host DuckDB -> Lakekeeper), duckdb-local (CSV fixtures, no Docker), trino
DQ_ENGINE=duckdb-local
# Absolute path of your local-data-lakehouse checkout (referenced by path, never copied)
DQ_LDL_REPO_PATH=/Users/santosh/Documents/workspace/local-data-lakehouse
DQ_LAKEKEEPER_URL=http://localhost:8181
DQ_LAKEKEEPER_WAREHOUSE=lakehouse
DQ_TRINO_HOST=localhost
DQ_TRINO_PORT=8088
# Gate policy: warnings never block unless this is true
DQ_FAIL_ON_WARN=false
# Sinks (JSON list): json, junit, markdown. Optional Iceberg table ops.dq_results:
DQ_SINKS=["json","junit","markdown"]
DQ_ICEBERG_SINK=false
# Slack incoming webhook (blank = console only). Never commit a real URL.
DQ_SLACK_WEBHOOK_URL=
DQ_SLACK_ONLY_ON_PROBLEMS=true
DQ_LOG_JSON=false
DQ_LOG_LEVEL=INFO
SODA_CORE_TELEMETRY_ENABLED=false
