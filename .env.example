# lakehouse-quality-gates settings: environment variables with the DQ_ prefix, read by pydantic-settings
# (src/soda_lakehouse_dq/settings.py). Copy with `make env`, then edit. Every setting is listed; the commented
# ones show their default.

# --- engine and lakehouse ---------------------------------------------------------------------------
# duckdb (host DuckDB -> Lakekeeper Iceberg), duckdb-local (CSV fixtures, no Docker), trino
DQ_ENGINE=duckdb-local
# Path of your local-data-lakehouse checkout (referenced by path, never copied). Needed for duckdb, trino,
# seed, the container and Airflow; not needed for duckdb-local.
DQ_LDL_REPO_PATH=../local-data-lakehouse
DQ_LAKEKEEPER_URL=http://localhost:8181
DQ_LAKEKEEPER_WAREHOUSE=lakehouse
# DQ_CATALOG_ALIAS=lakehouse
DQ_TRINO_HOST=localhost
DQ_TRINO_PORT=8088
# DuckDB inside containers: httplib resolves *.localhost; spill dir for a read-only root filesystem
# DQ_DUCKDB_HTTPFS_CLIENT=httplib
# DQ_DUCKDB_TEMP_DIRECTORY=/tmp/duckdb
# Soda data source names used in the rendered contracts
# DQ_DUCKDB_DATASOURCE_NAME=lakehouse_duckdb
# DQ_TRINO_DATASOURCE_NAME=lakehouse_trino

# --- gate policy ------------------------------------------------------------------------------------
# Warnings never block unless this is true
DQ_FAIL_ON_WARN=false
# Fail closed: a check that could not be evaluated blocks unless this is true
DQ_ALLOW_NOT_EVALUATED=false

# --- outputs ----------------------------------------------------------------------------------------
# Report formats (JSON list): json, junit, markdown
DQ_SINKS=["json","junit","markdown"]
# Also append one row per check to the Iceberg table ops.dq_results
DQ_ICEBERG_SINK=false
# Slack incoming webhook (blank = console only). Never commit a real URL.
DQ_SLACK_WEBHOOK_URL=
DQ_SLACK_ONLY_ON_PROBLEMS=true
DQ_LOG_JSON=false
DQ_LOG_LEVEL=INFO

# --- paths (defaults are the project folders) --------------------------------------------------------
# Write-audit-publish (soda-dq wap ..., ADR 0006)
# DQ_WAP_SPARK_CONTAINER=ldl-spark
# DQ_WAP_JOB=/opt/soda-wap/wap_job.py
# DQ_WAP_TIMEOUT_S=900
# DQ_WAP_DROP_BLOCKED=false
# DQ_CONTRACTS_DIR=contracts
# DQ_DATASOURCES_DIR=datasources
# DQ_REPORTS_DIR=reports
# DQ_SAMPLE_DIR=fixtures/good_batch

# --- third-party ------------------------------------------------------------------------------------
SODA_CORE_TELEMETRY_ENABLED=false
# Airflow host port for make airflow-dq-up / e2e-full (lakehouse default 8080; use 8090 if 8080 is taken)
# AIRFLOW_API_PORT=8080
