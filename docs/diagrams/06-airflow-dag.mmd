flowchart LR
  subgraph LOAD["Load"]
    direction TB
    ST[["land_smoke"]]:::node
    BR[["bronze"]]:::node
    IN[["inject_bad_batch<br/><small>no-op by default</small>"]]:::node
    ST --> BR --> IN
  end
  subgraph QB["Bronze gate"]
    direction TB
    DB("dq_bronze"):::ours
    F1(["Run failed"]):::blocked
    DB -. exit 1 .-> F1
  end
  subgraph QS["Silver"]
    direction TB
    SI[["silver"]]:::node
    DS("dq_silver"):::ours
    F2(["Run failed"]):::blocked
    SI --> DS
    DS -. exit 1 .-> F2
  end
  subgraph QG["Gold"]
    direction TB
    GO[["gold"]]:::node
    DG("dq_gold"):::ours
    F3(["Run failed"]):::blocked
    GO --> DG
    DG -. exit 1 .-> F3
  end
  EN(["query_timetravel"]):::pass
  LOAD --> QB
  QB -->|exit 0| QS
  QS -->|exit 0| QG
  QG -->|exit 0| EN
