%% Title: Data model
%% Purpose: The retail Iceberg tables the gates check and the ops.dq_results table they write
%% Last updated: 2026-10-13
%% Theme: docs/diagrams/THEME.md (shared init line above). Edit here, then run: make diagrams
erDiagram
  direction LR
  BRONZE_CUSTOMERS_RAW ||--o| SILVER_CUSTOMERS : "cleaned into"
  BRONZE_ORDERS_RAW ||--o| SILVER_ORDERS : "cleaned into"
  SILVER_CUSTOMERS ||--o{ SILVER_ORDERS : "customer_id"
  SILVER_ORDERS }o--|| GOLD_DAILY_ORDER_METRICS : "aggregated by day"
  BRONZE_ORDERS_RAW {
    varchar order_id
    varchar customer_id
    timestamptz order_ts
    varchar status
    double amount
    varchar _source_file
    timestamptz _ingested_at
  }
  BRONZE_CUSTOMERS_RAW {
    varchar customer_id
    varchar name
    varchar email
    varchar city
    date signup_date
    varchar _source_file
    timestamptz _ingested_at
  }
  SILVER_ORDERS {
    varchar order_id PK
    varchar customer_id FK
    timestamptz order_ts
    varchar status
    double amount
    varchar _source_file
    timestamptz _ingested_at
  }
  SILVER_CUSTOMERS {
    varchar customer_id PK
    varchar name
    varchar email
    varchar city
    date signup_date
    varchar _source_file
    timestamptz _ingested_at
  }
  GOLD_DAILY_ORDER_METRICS {
    date order_date PK
    bigint orders
    double revenue
    double avg_order_value
    bigint cancelled_orders
    bigint refunded_orders
  }
  OPS_DQ_RESULTS {
    varchar run_id
    timestamptz created_at
    varchar pipeline
    varchar layer
    varchar engine
    varchar gate_status
    varchar contract
    varchar dataset
    varchar check_name
    varchar check_type
    varchar column_name
    varchar outcome
  }
